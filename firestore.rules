rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── FORMS ────────────────────────────────────────────────────────────────
    // Admin (authenticated, non-anonymous) can read/write all forms.
    // Public (unauthenticated or anonymous) can only READ published forms.
    match /forms/{formId} {
      allow read: if resource.data.status == 'published'
                     || (request.auth != null && !request.auth.token.firebase.sign_in_provider.matches('anonymous'));
      allow write: if request.auth != null
                      && !request.auth.token.firebase.sign_in_provider.matches('anonymous');

      // ─── FIELDS ─────────────────────────────────────────────────────────────
      // Same as parent form: public can read fields of published forms.
      match /fields/{fieldId} {
        allow read: if get(/databases/$(database)/documents/forms/$(formId)).data.status == 'published'
                       || (request.auth != null && !request.auth.token.firebase.sign_in_provider.matches('anonymous'));
        allow write: if request.auth != null
                        && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
      }

      // ─── RESPONSES ───────────────────────────────────────────────────────────
      // Anyone (public) can CREATE a response (submit the form).
      // Only admins can READ or DELETE responses.
      match /responses/{responseId} {
        allow create: if true;  // Public form submission allowed
        allow read, delete: if request.auth != null
                               && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
      }
    }

    // ─── RESPONSE FILES ───────────────────────────────────────────────────────
    match /responseFiles/{fileId} {
      allow create: if true;   // Public form submission allowed
      allow read, delete: if request.auth != null
                             && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
    }

    // ─── AUDIT LOGS ───────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read, write: if request.auth != null
                            && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
    }

    // ─── EMPLOYEES / ID CARDS ─────────────────────────────────────────────────
    match /employees/{empId} {
      allow read: if true;   // Public scan of ID cards
      allow write: if request.auth != null
                      && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
    }

    // ─── CERTIFICATES ─────────────────────────────────────────────────────────
    match /certificates/{certId} {
      allow read: if true;   // Public certificate verification
      allow write: if request.auth != null
                      && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
    }

    // Deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
